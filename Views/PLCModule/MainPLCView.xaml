<UserControl
    x:Class="SeedCut.Views.PLCModule.MainPLCView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SeedCut.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SeedCut.Views.PLCModule"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="1400"
    Background="#F5F5F5"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  转换器定义  -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />

        <!--  顶部栏按钮样式  -->
        <Style x:Key="TopBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1976D2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#BDBDBD" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  断开按钮样式（红色）  -->
        <Style
            x:Key="DisconnectButtonStyle"
            BasedOn="{StaticResource TopBarButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#F44336" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  刷新按钮样式（绿色）  -->
        <Style
            x:Key="RefreshButtonStyle"
            BasedOn="{StaticResource TopBarButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#4CAF50" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  模块选择按钮基础样式  -->
        <Style x:Key="ModuleButtonBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#424242" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#2196F3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ========== 顶部控制栏 ==========  -->
        <Border
            Grid.Row="0"
            Padding="20,15"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  标题  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#212121"
                        Text="🔧 PLC控制中心" />

                    <TextBlock
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#757575"
                        Text="{Binding PLCAddress}" />
                </StackPanel>

                <!--  连接状态  -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="12"
                        Height="12"
                        Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#F44336" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding ConnectionStatus}" />
                </StackPanel>

                <!--  控制按钮  -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button
                        Command="{Binding ConnectCommand}"
                        Content="连接PLC"
                        Style="{StaticResource TopBarButtonStyle}" />

                    <Button
                        Command="{Binding DisconnectCommand}"
                        Content="断开连接"
                        Cursor="Hand"
                        Style="{StaticResource DisconnectButtonStyle}" />

                    <Button
                        Command="{Binding RefreshCommand}"
                        Content="刷新数据"
                        Style="{StaticResource RefreshButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ========== 主内容区 ==========  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧模块导航  -->
            <Border
                Grid.Column="0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock
                            Margin="0,0,0,15"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#757575"
                            Text="功能模块" />

                        <!--  模块列表  -->
                        <ItemsControl ItemsSource="{Binding AvailableModules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding DisplayName}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModuleButtonBaseStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <!--  ✅ 核心修改：使用 IsSelected 属性  -->
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#E3F2FD" />
                                                        <Setter Property="BorderBrush" Value="#2196F3" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Setter Property="Foreground" Value="#1976D2" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  右侧模块内容显示  -->
            <Border Grid.Column="1" Background="#F5F5F5">
                <ContentControl Content="{Binding CurrentModule}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <local:DynamicPLCModuleView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>
        </Grid>

        <!--  ========== 底部状态栏 ==========  -->
        <Border
            Grid.Row="2"
            Padding="20,10"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  繁忙指示器  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ProgressBar
                        Width="20"
                        Height="20"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!--  状态消息  -->
                <TextBlock
                    Grid.Column="1"
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#616161"
                    Text="{Binding StatusMessage}" />

                <!--  版本信息  -->
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#9E9E9E"
                    Text="PLC控制系统 v3.0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
