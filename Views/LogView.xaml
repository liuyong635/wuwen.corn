<UserControl
    x:Class="SeedCut.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1400"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  DataGrid 样式  -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="50" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!--  DataGrid 表头样式  -->
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E3F2FD" />
            <Setter Property="Foreground" Value="#1976D2" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="50" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="BorderBrush" Value="#BBDEFB" />
        </Style>

        <!--  DataGrid 单元格样式  -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BBDEFB" />
                    <Setter Property="Foreground" Value="#1976D2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  DataGrid 行样式  -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#BBDEFB" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!--  按钮样式  -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,15,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,20">
        <Border
            Padding="30"
            Background="White"
            CornerRadius="15">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20"
                    Opacity="0.1"
                    ShadowDepth="0" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  顶部标题区  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,20"
                    Padding="20,15"
                    Background="#E3F2FD"
                    CornerRadius="10">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                FontSize="22"
                                Text="📋" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#1976D2"
                                Text="任务日志" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#666"
                                Text="共 " />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#1976D2"
                                Text="{Binding TaskLogs.Count}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#666"
                                Text=" 条记录" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  数据表格  -->
                <Border
                    Grid.Row="1"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DataGrid
                        CellStyle="{StaticResource DataGridCellStyle}"
                        ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                        ItemsSource="{Binding TaskLogs}"
                        RowStyle="{StaticResource DataGridRowStyle}"
                        SelectedItem="{Binding SelectedTaskLog}"
                        Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <!--  任务编号  -->
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding TaskNumber}"
                                Header="任务编号" />

                            <!--  任务量  -->
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding TaskQuantity}"
                                Header="任务量" />

                            <!--  种子代号  -->
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding SeedCode}"
                                Header="种子代号" />

                            <!--  切割面积  -->
                            <DataGridTemplateColumn Width="120" Header="切割面积(cm²)">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" Text="{Binding CutArea}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  开始时间  -->
                            <DataGridTextColumn
                                Width="170"
                                Binding="{Binding StartTimeDisplay}"
                                Header="开始时间" />

                            <!--  结束时间  -->
                            <DataGridTextColumn
                                Width="170"
                                Binding="{Binding EndTimeDisplay}"
                                Header="结束时间" />

                            <!--  报警信息  -->
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding AlarmInfo}"
                                Header="报警信息">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="TextAlignment" Value="Center" />
                                        <Setter Property="ToolTip" Value="{Binding AlarmInfo}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!--  数据路径  -->
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding DataPath}"
                                Header="数据路径">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="TextAlignment" Value="Center" />
                                        <Setter Property="ToolTip" Value="{Binding DataPath}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!--  底部操作按钮  -->
                <StackPanel
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  打开文件按钮  -->
                    <Button Command="{Binding OpenFileCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource ActionButtonStyle}" TargetType="Button">
                                <Setter Property="Background" Value="#2196F3" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BDBDBD" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                Opacity="0.3"
                                ShadowDepth="0"
                                Color="#2196F3" />
                        </Button.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                FontSize="16"
                                Text="📂" />
                            <TextBlock FontSize="15" Text="打开文件" />
                        </StackPanel>
                    </Button>

                    <!--  刷新按钮  -->
                    <Button Command="{Binding RefreshCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource ActionButtonStyle}" TargetType="Button">
                                <Setter Property="Background" Value="#4CAF50" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#388E3C" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                FontSize="16"
                                Text="🔄" />
                            <TextBlock FontSize="15" Text="刷新数据" />
                        </StackPanel>
                    </Button>

                    <!--  导出按钮  -->
                    <Button Command="{Binding ExportCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource ActionButtonStyle}" TargetType="Button">
                                <Setter Property="Background" Value="#FF9800" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F57C00" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BDBDBD" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                FontSize="16"
                                Text="📥" />
                            <TextBlock FontSize="15" Text="导出数据" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
