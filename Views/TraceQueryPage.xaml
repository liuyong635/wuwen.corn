<UserControl
    x:Class="SeedCut.Views.TraceQueryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SeedCut.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    Background="#F5F5F5"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <local:NullToVisibilityConverter x:Key="NullToVisConverter" />

        <!--  卡片样式  -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.1"
                        ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主按钮样式  -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  次要按钮样式  -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BDBDBD" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  输入框样式  -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <Grid>
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="12,0"
                                    VerticalAlignment="Center"
                                    VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  标签样式  -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!--  重复标记样式  -->
        <Style x:Key="DuplicateBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF3E0" />
            <Setter Property="BorderBrush" Value="#FF9800" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="28"
                        Text="🔍" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#333333"
                        Text="料盘追溯查询" />
                </StackPanel>

                <!--  今日统计  -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Border
                        Margin="0,0,10,0"
                        Padding="15,8"
                        Background="#E3F2FD"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="#666" Text="今日配对: " />
                            <TextBlock
                                FontWeight="Bold"
                                Foreground="#2196F3"
                                Text="{Binding TodayStatistics.TotalPairings, FallbackValue=0}" />
                            <TextBlock Foreground="#666" Text=" 组" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="0,0,10,0"
                        Padding="15,8"
                        Background="#FFF3E0"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="#666" Text="重复: " />
                            <TextBlock
                                FontWeight="Bold"
                                Foreground="#FF9800"
                                Text="{Binding TodayStatistics.DuplicateCount, FallbackValue=0}" />
                            <TextBlock Foreground="#666" Text=" 次" />
                        </StackPanel>
                    </Border>
                    <Border
                        Padding="15,8"
                        Background="#E8F5E9"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="#666" Text="重复率: " />
                            <TextBlock FontWeight="Bold" Foreground="#4CAF50">
                                <TextBlock.Text>
                                    <Binding
                                        FallbackValue="0.00%"
                                        Path="TodayStatistics.DuplicateRate"
                                        StringFormat="{}{0:F2}%" />
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!--  查询区域  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,20"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  快速查询  -->
                <StackPanel Grid.Column="0">
                    <TextBlock
                        Margin="0,0,0,15"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="快速查询" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Style="{StaticResource InputStyle}"
                            Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" Text="🔍" />
                                <TextBlock Text="查询" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource LabelStyle}"
                        Text="提示：输入小料盘条码、大料盘条码或追溯号均可查询" />
                </StackPanel>

                <!--  分隔线  -->
                <Border
                    Grid.Column="1"
                    Width="1"
                    Margin="30,0"
                    Background="#E0E0E0" />

                <!--  高级查询  -->
                <StackPanel Grid.Column="2">
                    <TextBlock
                        Margin="0,0,0,15"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="按时间范围查询" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <DatePicker
                            Grid.Column="0"
                            Height="40"
                            FontSize="14"
                            SelectedDate="{Binding StartDate}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            Text="至" />
                        <DatePicker
                            Grid.Column="2"
                            Height="40"
                            FontSize="14"
                            SelectedDate="{Binding EndDate}" />
                        <CheckBox
                            Grid.Column="3"
                            Margin="15,0"
                            VerticalAlignment="Center"
                            Content="仅重复"
                            IsChecked="{Binding OnlyDuplicates}" />
                        <Button
                            Grid.Column="4"
                            Command="{Binding SearchByTimeRangeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}">
                            <TextBlock Text="查询" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!--  结果区域  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  查询结果列表  -->
            <Border
                Grid.Column="0"
                Margin="0,0,10,0"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,15"
                        Orientation="Horizontal">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="查询结果" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="#666"
                            Text="{Binding QueryResults.Count, StringFormat=' ({0} 条)'}" />
                    </StackPanel>

                    <DataGrid
                        Grid.Row="1"
                        AlternatingRowBackground="#FAFAFA"
                        AutoGenerateColumns="False"
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        ColumnHeaderHeight="40"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding QueryResults}"
                        RowHeight="45"
                        SelectedItem="{Binding SelectedPairing}"
                        SelectionMode="Single">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F5F5" />
                                <Setter Property="Foreground" Value="#333333" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderBrush" Value="#E0E0E0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding TraceId}"
                                Header="追溯号" />
                            <DataGridTemplateColumn Width="150" Header="小料盘条码">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding SmallTrayBarcode}" />
                                            <Border Style="{StaticResource DuplicateBadgeStyle}" Visibility="{Binding IsSmallDuplicate, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#FF9800"
                                                    Text="重复" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="150" Header="大料盘条码">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding LargeTrayBarcode}" />
                                            <Border Style="{StaticResource DuplicateBadgeStyle}" Visibility="{Binding IsLargeDuplicate, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#FF9800"
                                                    Text="重复" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding PairTime, StringFormat='{}{0:MM-dd HH:mm:ss}'}"
                                Header="配对时间" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!--  详情面板  -->
            <Border
                Grid.Column="1"
                Margin="10,0,0,0"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,15"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="详细信息" />

                    <!--  选中记录详情  -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPairing}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!--  追溯号  -->
                            <Border
                                Margin="0,0,0,15"
                                Padding="15"
                                Background="#E3F2FD"
                                CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="追溯号" />
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#2196F3"
                                        Text="{Binding SelectedPairing.TraceId}" />
                                </StackPanel>
                            </Border>

                            <!--  小料盘信息  -->
                            <TextBlock
                                Margin="0,0,0,8"
                                FontWeight="SemiBold"
                                Text="小料盘" />
                            <Border
                                Margin="0,0,0,15"
                                Padding="15"
                                Background="#FAFAFA"
                                CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="条码" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="14" Text="{Binding SelectedPairing.SmallTrayBarcode}" />
                                            <Border Style="{StaticResource DuplicateBadgeStyle}" Visibility="{Binding SelectedPairing.IsSmallDuplicate, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#FF9800"
                                                    Text="重复" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="扫码时间" />
                                        <TextBlock FontSize="14" Text="{Binding SelectedPairing.SmallTrayScanTime, StringFormat='{}{0:HH:mm:ss}'}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  大料盘信息  -->
                            <TextBlock
                                Margin="0,0,0,8"
                                FontWeight="SemiBold"
                                Text="大料盘" />
                            <Border
                                Margin="0,0,0,15"
                                Padding="15"
                                Background="#FAFAFA"
                                CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="条码" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="14" Text="{Binding SelectedPairing.LargeTrayBarcode}" />
                                            <Border Style="{StaticResource DuplicateBadgeStyle}" Visibility="{Binding SelectedPairing.IsLargeDuplicate, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#FF9800"
                                                    Text="重复" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="扫码时间" />
                                        <TextBlock FontSize="14" Text="{Binding SelectedPairing.LargeTrayScanTime, StringFormat='{}{0:HH:mm:ss}'}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  配对时间  -->
                            <TextBlock
                                Margin="0,0,0,8"
                                FontWeight="SemiBold"
                                Text="配对信息" />
                            <Border
                                Padding="15"
                                Background="#FAFAFA"
                                CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="配对时间" />
                                        <TextBlock FontSize="14" Text="{Binding SelectedPairing.PairTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="记录时间" />
                                        <TextBlock FontSize="14" Text="{Binding SelectedPairing.CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  未选中提示  -->
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#999999"
                        Text="请选择一条记录查看详情">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPairing}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!--  底部状态栏  -->
        <Border Grid.Row="3" Margin="0,20,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#666666"
                        Text="{Binding StatusMessage}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#2196F3"
                        Text="  |  正在加载..."
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Margin="0,0,10,0"
                        Command="{Binding ViewDuplicatesCommand}"
                        Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,5,0" Text="⚠️" />
                            <TextBlock Text="重复记录" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="0,0,10,0"
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,5,0" Text="📥" />
                            <TextBlock Text="导出" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshStatisticsCommand}" Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,5,0" Text="🔄" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
