<UserControl
    x:Class="SeedCut.Views.RobotView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SeedCut.Views.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    Background="#F5F5F5"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ✅ Converters - 确保所有使用的转换器都在这里声明  -->
        <local:BoolToColorConverter x:Key="BoolToColorConverter" />
        <local:BoolToColorConverter2 x:Key="BoolToColorConverter2" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBoolConverter x:Key="InverseBoolConverter" />

        <!--  通用样式  -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC" />
                    <Setter Property="Foreground" Value="#666666" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JogButton" TargetType="Button">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#4CAF50" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#45a049" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC" />
                    <Setter Property="Foreground" Value="#666666" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CoordinateDisplay" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#007ACC" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5" />
        </Style>

        <!--  ✅ 连接指示灯样式（支持三种状态）  -->
        <Style x:Key="ConnectionIndicator" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Background" Value="#FF4444" />
            <Style.Triggers>
                <!--  已连接：绿色  -->
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Background" Value="#44BB44" />
                </DataTrigger>
                <!--  重连中：橙色闪烁  -->
                <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
                    <Setter Property="Background" Value="#FFA500" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    AutoReverse="True"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1"
                                    To="0.3"
                                    Duration="0:0:0.5" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部：连接控制  -->
        <GroupBox Grid.Row="0" Header="连接设置">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource LabelStyle}"
                    Text="IP地址:" />
                <TextBox
                    Grid.Column="1"
                    Margin="5"
                    IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                    Text="{Binding IPAddress}" />

                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource LabelStyle}"
                    Text="端口:" />
                <TextBox
                    Grid.Column="3"
                    Margin="5"
                    IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                    Text="{Binding Port}" />

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button
                        Width="120"
                        Command="{Binding ConnectCommand}"
                        Content="{Binding ConnectionButtonText}"
                        Style="{StaticResource PrimaryButton}" />

                    <!--  ✅ 使用新的指示灯样式  -->
                    <Border Style="{StaticResource ConnectionIndicator}" ToolTip="{Binding ConnectionStatusText}" />

                    <!--  ✅ 重连次数显示  -->
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#FFA500"
                        Text="{Binding RetryCount, StringFormat=重连:{0}}"
                        Visibility="{Binding IsReconnecting, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!--  中间：主要内容  -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：坐标显示和控制  -->
            <StackPanel Grid.Column="0">
                <!--  坐标显示  -->
                <GroupBox Header="当前坐标">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="5"
                            FontSize="18"
                            Text="X:" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource CoordinateDisplay}"
                            Text="{Binding CoordinateX, StringFormat=F2}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="5"
                            FontSize="18"
                            Text="Y:" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource CoordinateDisplay}"
                            Text="{Binding CoordinateY, StringFormat=F2}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="5"
                            FontSize="18"
                            Text="Z:" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource CoordinateDisplay}"
                            Text="{Binding CoordinateZ, StringFormat=F2}" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="5"
                            FontSize="18"
                            Text="C:" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource CoordinateDisplay}"
                            Text="{Binding CoordinateC, StringFormat=F2}" />

                        <Button
                            Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Margin="5,10,5,5"
                            Command="{Binding ReadCoordinatesCommand}"
                            Content="读取坐标"
                            Style="{StaticResource PrimaryButton}" />
                    </Grid>
                </GroupBox>

                <!--  伺服控制  -->
                <GroupBox Header="伺服控制">
                    <StackPanel>
                        <StackPanel
                            Margin="10"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="5"
                                FontSize="16"
                                Text="伺服状态:" />
                            <TextBlock
                                Margin="5"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{Binding IsServoEnabled, Converter={StaticResource BoolToColorConverter2}}"
                                Text="{Binding ServoStatusText}" />
                        </StackPanel>

                        <Button
                            Command="{Binding ToggleServoCommand}"
                            Content="{Binding ServoButtonText}"
                            Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </GroupBox>

                <!--  程序控制  -->
                <GroupBox Header="程序控制">
                    <UniformGrid Columns="2" Rows="2">
                        <Button
                            Command="{Binding RunARCommand}"
                            Content="运行"
                            Style="{StaticResource PrimaryButton}" />
                        <Button
                            Command="{Binding PauseARCommand}"
                            Content="暂停"
                            Style="{StaticResource PrimaryButton}" />
                        <Button
                            Command="{Binding StopARCommand}"
                            Content="停止"
                            Style="{StaticResource PrimaryButton}" />
                        <Button
                            Command="{Binding ResetRobotCommand}"
                            Content="复位"
                            Style="{StaticResource PrimaryButton}" />
                    </UniformGrid>
                </GroupBox>
            </StackPanel>

            <!--  右侧：JOG 控制  -->
            <StackPanel Grid.Column="1">
                <!--  XY 轴 JOG  -->
                <GroupBox Header="XY 轴 JOG 控制">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Y+  -->
                        <Button
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            Content="Y+"
                            PreviewMouseLeftButtonDown="JogYPlus_MouseDown"
                            PreviewMouseLeftButtonUp="JogYPlus_MouseUp"
                            Style="{StaticResource JogButton}" />

                        <!--  X- 和 X+  -->
                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Content="X-"
                                PreviewMouseLeftButtonDown="JogXMinus_MouseDown"
                                PreviewMouseLeftButtonUp="JogXMinus_MouseUp"
                                Style="{StaticResource JogButton}" />
                            <TextBlock
                                Margin="20,0"
                                VerticalAlignment="Center"
                                FontSize="30"
                                Text="●" />
                            <Button
                                Content="X+"
                                PreviewMouseLeftButtonDown="JogXPlus_MouseDown"
                                PreviewMouseLeftButtonUp="JogXPlus_MouseUp"
                                Style="{StaticResource JogButton}" />
                        </StackPanel>

                        <!--  Y-  -->
                        <Button
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            Content="Y-"
                            PreviewMouseLeftButtonDown="JogYMinus_MouseDown"
                            PreviewMouseLeftButtonUp="JogYMinus_MouseUp"
                            Style="{StaticResource JogButton}" />
                    </Grid>
                </GroupBox>

                <!--  Z 轴 JOG  -->
                <GroupBox Header="Z 轴 JOG 控制">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button
                            Content="Z-"
                            PreviewMouseLeftButtonDown="JogZMinus_MouseDown"
                            PreviewMouseLeftButtonUp="JogZMinus_MouseUp"
                            Style="{StaticResource JogButton}" />
                        <Button
                            Content="Z+"
                            PreviewMouseLeftButtonDown="JogZPlus_MouseDown"
                            PreviewMouseLeftButtonUp="JogZPlus_MouseUp"
                            Style="{StaticResource JogButton}" />
                    </StackPanel>
                </GroupBox>

                <!--  C 轴 JOG  -->
                <GroupBox Header="C 轴 JOG 控制">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button
                            Content="C-"
                            PreviewMouseLeftButtonDown="JogCMinus_MouseDown"
                            PreviewMouseLeftButtonUp="JogCMinus_MouseUp"
                            Style="{StaticResource JogButton}" />
                        <Button
                            Content="C+"
                            PreviewMouseLeftButtonDown="JogCPlus_MouseDown"
                            PreviewMouseLeftButtonUp="JogCPlus_MouseUp"
                            Style="{StaticResource JogButton}" />
                    </StackPanel>
                </GroupBox>

                <!--  停止按钮  -->
                <Button
                    Height="50"
                    Margin="10"
                    Background="#F44336"
                    Command="{Binding StopJogCommand}"
                    Content="停止 JOG"
                    FontSize="16"
                    Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>

        <!--  底部：状态栏  -->
        <Border
            Grid.Row="2"
            Padding="10,5"
            Background="#2C3E50">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontSize="14"
                    Foreground="White"
                    Text="{Binding StatusMessage}" />

                <!--  连接状态详情  -->
                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    Foreground="#AAAAAA"
                    Text="{Binding ConnectionStatusText}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
