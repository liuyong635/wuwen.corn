<UserControl x:Class="SeedCut.Views.HM_LaserDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="650"
             Background="#F5F5F5">

    <UserControl.Resources>
        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#757575"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#616161"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FF9800"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F57C00"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- GroupBox样式 -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- 参数输入框样式 -->
        <Style x:Key="ParamTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- 参数标签样式 -->
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="90"/>
        </Style>

        <!-- Expander样式 -->
        <Style TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="15">

            <!-- 标题栏 -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="HM激光器调试 (GMC控制卡)" 
                           FontSize="18" FontWeight="Bold" Foreground="#333"/>
                
            </Grid>

            <!-- ==================== 连接控制 ==================== -->
            <GroupBox Header="🔌 连接控制">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="控制卡IP:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="8,6"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="连接" Command="{Binding ConnectCommand}"
                                Style="{StaticResource PrimaryButton}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="断开" Command="{Binding DisconnectCommand}"
                                Style="{StaticResource SecondaryButton}" Width="100"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="14" Height="14" Fill="{Binding ConnectionIndicator}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text=" | " Foreground="#999" Margin="10,0"/>
                        <TextBlock Text="工作状态: " Foreground="#666"/>
                        <TextBlock Text="{Binding WorkStatus}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- ==================== 快速配置摘要 ==================== -->
            <GroupBox Header="📊 当前配置摘要">
                <StackPanel>
                    <TextBlock Text="{Binding ConfigSummary}" Foreground="#666" FontSize="12" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="💾 保存配置" Command="{Binding SaveConfigCommand}"
                                Style="{StaticResource SuccessButton}" Margin="0,0,10,0"/>
                        <Button Content="🔄 重新加载" Command="{Binding ReloadConfigCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                        <Button Content="↩️ 恢复默认" Command="{Binding ResetToDefaultCommand}"
                                Style="{StaticResource WarningButton}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- ==================== 振镜参数 ==================== -->
            <Expander Header="⚙️ 振镜参数" IsExpanded="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 左列 -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,5">
                        <TextBlock Text="打标速度 (mm/s)" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding MarkSpeed, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,5">
                        <TextBlock Text="打标延时 (μs)" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding MarkDelay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,5">
                        <TextBlock Text="转弯延时 (μs)" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding PolygonDelay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>

                    <!-- 右列 -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,5">
                        <TextBlock Text="跳转速度 (mm/s)" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding JumpSpeed, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,5">
                        <TextBlock Text="跳转延时 (μs)" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding JumpDelay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,5">
                        <TextBlock Text="打标次数" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding MarkCount, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- ==================== 激光参数 ==================== -->
            <Expander Header="🔆 激光参数" IsExpanded="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 功率滑块 -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Margin="0,5,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="激光功率 (%)" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" 
                                    Value="{Binding LaserPower}" 
                                    TickFrequency="10" IsSnapToTickEnabled="False"/>
                            <TextBox Grid.Column="2" 
                                     Text="{Binding LaserPower, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                                     Style="{StaticResource ParamTextBox}" Width="60"/>
                        </Grid>
                    </StackPanel>

                    <!-- 左列 -->
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,5">
                        <TextBlock Text="出光频率 (kHz)" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,5">
                        <TextBlock Text="开激光延时 (μs)" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding LaserOnDelay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,5">
                        <TextBlock Text="首脉冲延时 (μs)" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding FPKDelay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="4" Margin="0,5">
                        <TextBlock Text="待机频率 (kHz)" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding StandbyFrequency, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>

                    <!-- 右列 -->
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,5">
                        <TextBlock Text="占空比 (%)" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding DutyCyclePercent, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,5">
                        <TextBlock Text="关激光延时 (μs)" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding LaserOffDelay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="3" Margin="0,5">
                        <TextBlock Text="首脉冲长度 (μs)" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding FPKLength, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="4" Margin="0,5">
                        <TextBlock Text="待机占空比" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding StandbyDutyCycle, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" 
                                 Style="{StaticResource ParamTextBox}"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- ==================== 工作区域 ==================== -->
            <Expander Header="📐 工作区域">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,5">
                            <TextBlock Text="X最小 (mm)" Style="{StaticResource ParamLabel}"/>
                            <TextBox Text="{Binding WorkAreaMinX, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ParamTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,5">
                            <TextBlock Text="X最大 (mm)" Style="{StaticResource ParamLabel}"/>
                            <TextBox Text="{Binding WorkAreaMaxX, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ParamTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,5">
                            <TextBlock Text="Y最小 (mm)" Style="{StaticResource ParamLabel}"/>
                            <TextBox Text="{Binding WorkAreaMinY, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ParamTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,5">
                            <TextBlock Text="Y最大 (mm)" Style="{StaticResource ParamLabel}"/>
                            <TextBox Text="{Binding WorkAreaMaxY, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ParamTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="启用坐标范围检查" 
                              IsChecked="{Binding EnableCoordinateCheck}" 
                              Margin="0,10,0,0"/>
                </StackPanel>
            </Expander>

            <!-- ==================== 高级参数 ==================== -->
            <Expander Header="🔧 高级参数">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 协议选择 -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,5">
                            <TextBlock Text="振镜协议" Style="{StaticResource ParamLabel}"/>
                            <ComboBox SelectedIndex="{Binding Protocol}" Width="100" HorizontalAlignment="Left">
                                <ComboBoxItem Content="SPI"/>
                                <ComboBoxItem Content="XY2-100"/>
                                <ComboBoxItem Content="SL2"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,5">
                            <TextBlock Text="打标维度" Style="{StaticResource ParamLabel}"/>
                            <ComboBox SelectedIndex="{Binding Dimensional}" Width="80" HorizontalAlignment="Left">
                                <ComboBoxItem Content="2D"/>
                                <ComboBoxItem Content="3D"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,5">
                            <TextBlock Text="波形号 (0-63)" Style="{StaticResource ParamLabel}"/>
                            <TextBox Text="{Binding Waveform, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ParamTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,5">
                            <TextBlock Text="MOPA脉宽 (ns)" Style="{StaticResource ParamLabel}"/>
                            <TextBox Text="{Binding MOPAPulseWidth, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ParamTextBox}"
                                     IsEnabled="{Binding EnableMOPA}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 开关选项 -->
                    <StackPanel Margin="0,10,0,0">
                        <CheckBox Content="打标完成后振镜回零" 
                                  IsChecked="{Binding JumpToZeroAfterMark}" Margin="0,5"/>
                        <CheckBox Content="使用模拟量控制能量 (0-10V)" 
                                  IsChecked="{Binding UseAnalogPower}" Margin="0,5"/>
                        <CheckBox Content="启用MOPA脉宽模式" 
                                  IsChecked="{Binding EnableMOPA}" Margin="0,5"/>
                    </StackPanel>

                    <!-- 超时设置 -->
                    <TextBlock Text="超时设置" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,5">
                            <TextBlock Text="连接超时 (ms)" Style="{StaticResource ParamLabel}"/>
                            <TextBox Text="{Binding ConnectionTimeoutMs, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ParamTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,5">
                            <TextBlock Text="下载超时 (ms)" Style="{StaticResource ParamLabel}"/>
                            <TextBox Text="{Binding DownloadTimeoutMs, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ParamTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,5">
                            <TextBlock Text="打标超时 (ms)" Style="{StaticResource ParamLabel}"/>
                            <TextBox Text="{Binding MarkTimeoutMs, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ParamTextBox}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- ==================== 测试打标 ==================== -->
            <GroupBox Header="🎯 测试打标">
                <StackPanel>
                    <TextBlock Text="坐标数据 (格式: x1,y1,x2,y2;x3,y3,x4,y4;...)" 
                               FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding TestCoordinates, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Height="60" Padding="8,6" VerticalScrollBarVisibility="Auto"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                        <Button Content="▶ 开始打标" Command="{Binding TestMarkCommand}"
                                Style="{StaticResource PrimaryButton}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="⏹ 停止" Command="{Binding StopMarkCommand}"
                                Style="{StaticResource DangerButton}" Width="80"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="进度:" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Value="{Binding MarkProgress}" Height="20" Margin="5,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding MarkProgress, StringFormat={}{0}%}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- ==================== 区域填充测试 ==================== -->
            <GroupBox Header="🔲 区域填充测试">
                <StackPanel>
                    <!-- 格式说明 -->
                    <TextBlock Text="格式: AddAreas[x1,y1,x2,y2:x3,y3,x4,y4:...] (线段首尾相连构成闭环)" 
                   FontSize="11" Foreground="#666" Margin="0,0,0,5" TextWrapping="Wrap"/>

                    <!-- 区域坐标输入 -->
                    <TextBox Text="{Binding AreaCoordinates, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 Height="60" Padding="8,6" VerticalScrollBarVisibility="Auto"
                 ToolTip="输入闭环多边形的线段坐标，每条线段格式为 x1,y1,x2,y2"/>

                    <!-- 填充参数 -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="线间距(mm):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" 
                     Text="{Binding FillLineSpacing, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="5,3"
                     ToolTip="填充线之间的间距，值越小填充越密"/>

                        <TextBlock Grid.Column="2" Text="  预设:" VerticalAlignment="Center" Foreground="#666"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="矩形" Padding="8,2" Margin="0,0,5,0"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="预设一个10x6mm的矩形"
                        Command="{Binding PresetRectangleCommand}"/>
                            <Button Content="三角" Padding="8,2" Margin="0,0,5,0"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="预设一个等边三角形"
                        Command="{Binding PresetTriangleCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="▶ 开始填充" Command="{Binding FillAreaCommand}"
                    Style="{StaticResource SuccessButton}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="⏹ 停止" Command="{Binding StopMarkCommand}"
                    Style="{StaticResource DangerButton}" Width="80"/>
                    </StackPanel>

                    <!-- 效果示意 -->
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" 
                Margin="0,10,0,0" Padding="10" Background="#FAFAFA">
                        <StackPanel>
                            <TextBlock Text="蛇形填充效果示意:" FontSize="11" Foreground="#666"/>
                            <TextBlock Text="→→→→→→→→→→→→→→" FontFamily="Consolas" Foreground="#2196F3" Margin="0,3,0,0"/>
                            <TextBlock Text="←←←←←←←←←←←←←←" FontFamily="Consolas" Foreground="#2196F3"/>
                            <TextBlock Text="→→→→→→→→→→→→→→" FontFamily="Consolas" Foreground="#2196F3"/>
                            <TextBlock Text="←←←←←←←←←←←←←←" FontFamily="Consolas" Foreground="#2196F3"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- ==================== 辅助功能 ==================== -->
            <GroupBox Header="🛠️ 辅助功能">
                <WrapPanel>
                    <Button Content="🔴 红光开" Command="{Binding RedLightOnCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,10,5"/>
                    <Button Content="⚫ 红光关" Command="{Binding RedLightOffCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,10,5"/>
                    <Button Content="🎯 振镜回零" Command="{Binding JumpToZeroCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,10,5"/>
                    <Button Content="🔄 刷新状态" Command="{Binding RefreshStatusCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,10,5"/>
                </WrapPanel>
            </GroupBox>

            <!-- ==================== 状态显示 ==================== -->
            <GroupBox Header="📢 状态">
                <TextBlock Text="{Binding StatusMessage}" 
                           FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
            </GroupBox>

            <!-- ==================== 日志 ==================== -->
            <GroupBox Header="📋 日志">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <Button Content="清除日志" Command="{Binding ClearLogsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Padding="10,4" Margin="0,0,0,5"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Logs}"
                             BorderThickness="1" BorderBrush="#E0E0E0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding TimeString}" 
                                               Foreground="#999" FontSize="11" Width="85"/>
                                    <TextBlock Text="{Binding Message}" 
                                               Foreground="{Binding LevelBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
