<UserControl
    x:Class="SeedCut.Views.VibratorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:SeedCut.Views.Converters"
    d:DesignHeight="800"
    d:DesignWidth="1270"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- ✅ 添加转换器用于指示灯颜色和可见性绑定 -->
        <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!--  按钮样式  -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="35" />
            <Setter Property="Background" Value="#00CC00" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00AA00" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#009900" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="DangerButton"
            BasedOn="{StaticResource PrimaryButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#FF0000" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CC0000" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#AA0000" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Height" Value="35" />
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="BorderBrush" Value="#AAAAAA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D0D0D0" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F5F5F5" />
                    <Setter Property="Foreground" Value="#999999" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="80" />
            <Setter Property="Background" Value="#757575" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="#424242" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#616161" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#424242" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧控制面板  -->
        <Border
            Grid.Column="0"
            Background="#F0F0F0"
            BorderBrush="#CCCCCC"
            BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <!--  连接控制  -->
                    <GroupBox Margin="0,0,0,15" Header="设备连接">
                        <StackPanel>
                            <Grid Margin="0,10,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Command="{Binding ConnectCommand}"
                                    Content="连接"
                                    Style="{StaticResource PrimaryButton}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding DisconnectCommand}"
                                    Content="断开"
                                    Style="{StaticResource DangerButton}" />
                            </Grid>

                            <!-- ✅ 修改：使用 BoolToColorConverter 绑定指示灯颜色 -->
                            <Border
                                Height="35"
                                Background="White"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="3">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <!-- ✅ 指示灯颜色绑定到 IsConnected，使用 BoolToColorConverter -->
                                    <Ellipse
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,8,0"
                                        Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#666666"
                                        Text="{Binding ConnectionStatus}" />
                                </StackPanel>
                            </Border>

                            <!-- ✅ 新增：显示重连状态（当正在重连时显示） -->
                            <TextBlock
                                Margin="0,5,0,0"
                                FontSize="10"
                                Foreground="#FF9800"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsReconnecting, Converter={StaticResource BoolToVisibilityConverter}}"
                                Text="{Binding StatusMessage}" />
                        </StackPanel>
                    </GroupBox>

                    <!--  光源控制  -->
                    <GroupBox Margin="0,0,0,15" Header="光源控制">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Command="{Binding ToggleLightACommand}"
                                Content="光源A"
                                Style="{StaticResource ControlButton}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding ToggleLightBCommand}"
                                Content="光源B"
                                Style="{StaticResource ControlButton}" />
                        </Grid>
                    </GroupBox>

                    <!--  料仓控制  -->
                    <GroupBox Margin="0,0,0,15" Header="料仓控制">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Row="0"
                                Grid.Column="0"
                                Command="{Binding FeedCommand}"
                                Content="抖料"
                                Style="{StaticResource ControlButton}" />
                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                Command="{Binding PourCommand}"
                                Content="排料门"
                                Style="{StaticResource ControlButton}" />
                            <Button
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Command="{Binding VibrateCommand}"
                                Content="振动"
                                Style="{StaticResource ControlButton}" />

                            <Button
                                Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Command="{Binding VibrationGroup2Command}"
                                Content="振动2"
                                Style="{StaticResource ControlButton}" />
                        </Grid>
                    </GroupBox>

                    <!--  设备状态  -->
                    <GroupBox Header="设备状态">
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <TextBlock
                                    Width="70"
                                    FontSize="11"
                                    Foreground="#666666"
                                    Text="振动盘:" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="{Binding VibratorStateText}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <TextBlock
                                    Width="70"
                                    FontSize="11"
                                    Foreground="#666666"
                                    Text="料仓状态:" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="{Binding BoxStateText}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Width="70"
                                    FontSize="11"
                                    Foreground="#666666"
                                    Text="光源状态:" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{Binding LightStateBrush}"
                                    Text="{Binding LightStateText}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  右侧控制区域  -->
        <Border
            Grid.Column="2"
            Background="#FAFAFA"
            BorderBrush="#CCCCCC"
            BorderThickness="0,0,0,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <TextBlock
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#333333"
                    Text="振动盘控制面板" />

                <!--  控制按钮区域  -->
                <Border
                    Grid.Row="2"
                    Width="500"
                    Height="300"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="#E0E0E0"
                    BorderThickness="2"
                    CornerRadius="10">
                    <Grid Margin="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Command="{Binding StopVibratorCommand}"
                            Content="振动盘停止"
                            Style="{StaticResource ActionButton}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Command="{Binding StopBoxCommand}"
                            Content="料仓停止"
                            Style="{StaticResource ActionButton}" />
                    </Grid>
                </Border>

                <!--  底部提示  -->
                <Border
                    Grid.Row="3"
                    Height="50"
                    Background="#FFF3E0"
                    CornerRadius="5">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,15,0"
                            FontSize="20"
                            Foreground="#FF9800"
                            Text="⚠" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#666666"
                            Text="注意：操作前请确认设备已连接，且周围安全" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
