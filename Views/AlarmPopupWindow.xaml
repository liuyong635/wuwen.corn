<Window
    x:Class="SeedCut.Views.AlarmPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SeedCut.Views"
    Title="报警提示"
    Width="420"
    Height="280"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <!--  ✅ 修复：将Resources移到顶部，并添加StringToVisibilityConverter  -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Window.Resources>

    <Border
        x:Name="MainBorder"
        Background="#FFEBEE"
        BorderBrush="#C62828"
        BorderThickness="2"
        CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Opacity="0.4"
                ShadowDepth="3" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题栏  -->
            <Border
                Grid.Row="0"
                Padding="12,8"
                Background="#C62828"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="IconText"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Text="🚨" />

                    <TextBlock
                        x:Name="TitleText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="错误报警" />

                    <TextBlock
                        x:Name="TimeText"
                        Grid.Column="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#FFCDD2"
                        Text="12:00:00" />

                    <Button
                        Grid.Column="3"
                        Width="24"
                        Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        Content="✕"
                        Cursor="Hand"
                        FontSize="14"
                        Foreground="White" />
                </Grid>
            </Border>

            <!--  内容区域  -->
            <ScrollViewer
                Grid.Row="1"
                Padding="16,12"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!--  报警代码  -->
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#666"
                            Text="报警代码: " />
                        <TextBlock
                            x:Name="AlarmCodeText"
                            FontWeight="Bold"
                            Foreground="#C62828"
                            Text="ERR001" />
                    </StackPanel>

                    <!--  报警名称  -->
                    <TextBlock
                        x:Name="AlarmNameText"
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="轴1正极限报警"
                        TextWrapping="Wrap" />

                    <!--  来源模块  -->
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock Foreground="#666" Text="来源模块: " />
                        <TextBlock
                            x:Name="SourceModuleText"
                            Foreground="#333"
                            Text="运动控制" />
                    </StackPanel>

                    <!--  报警描述  -->
                    <TextBlock
                        x:Name="DescriptionText"
                        Margin="0,0,0,12"
                        Foreground="#555"
                        Text="轴1触发正极限开关，请检查机械位置"
                        TextWrapping="Wrap" />

                    <!--  建议处理  -->
                    <Border
                        Padding="10"
                        Background="#FFF8E1"
                        CornerRadius="4"
                        Visibility="{Binding ElementName=SuggestedActionText, Path=Text, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontWeight="SemiBold"
                                Foreground="#F57C00"
                                Text="💡 建议处理:" />
                            <TextBlock
                                x:Name="SuggestedActionText"
                                Foreground="#666"
                                Text="请检查轴1位置，手动退出极限区域"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  底部按钮  -->
            <Border
                Grid.Row="2"
                Padding="12,10"
                Background="#FAFAFA"
                CornerRadius="0,0,6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ViewAllButton_Click"
                        Content="查看全部报警"
                        Cursor="Hand"
                        Foreground="#1976D2" />

                    <Button
                        Grid.Column="1"
                        Width="70"
                        Height="30"
                        Margin="0,0,8,0"
                        Background="#E0E0E0"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        Content="关闭"
                        Cursor="Hand"
                        Foreground="#333" />

                    <Button
                        x:Name="AcknowledgeButton"
                        Grid.Column="2"
                        Width="90"
                        Height="30"
                        Background="#C62828"
                        BorderThickness="0"
                        Click="AcknowledgeButton_Click"
                        Content="确认报警"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Foreground="White" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
