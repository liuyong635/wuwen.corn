<UserControl x:Class="SeedCut.Views.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:SeedCut.Views.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== 新增：配置相机快速连接区域 ========== -->
        <Border Grid.Row="0" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1" 
                CornerRadius="5" 
                Padding="15" 
                Margin="0,0,0,10"
                Background="#F8F9FA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题行 -->
                <TextBlock Grid.Row="0" 
                           Text="📷 配置相机快速连接" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="#2C3E50"
                           Margin="0,0,0,10"/>

                <!-- 控制行 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 选择相机标签 -->
                    <TextBlock Grid.Column="0" 
                               Text="选择相机:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"
                               FontSize="14"/>

                    <!-- 配置相机下拉框 -->
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding ConfiguredCameras}"
                              SelectedItem="{Binding SelectedConfiguredCamera}"
                              Height="32"
                              VerticalContentAlignment="Center"
                              Margin="0,0,10,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Purpose, StringFormat='({0})'}" Foreground="Gray" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 连接按钮 -->
                    <Button Grid.Column="2" 
                            Content="连接" 
                            Command="{Binding ConnectConfiguredCameraCommand}"
                            Width="80" 
                            Height="32"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    CornerRadius="4"
                                                    Padding="10,5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#45A049"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#CCCCCC"/>
                                                    <Setter Property="Foreground" Value="#999999"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 断开按钮 -->
                    <Button Grid.Column="3" 
                            Content="断开" 
                            Command="{Binding DisconnectConfiguredCameraCommand}"
                            Width="80" 
                            Height="32"
                            Background="#F44336"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,15,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    CornerRadius="4"
                                                    Padding="10,5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E53935"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#CCCCCC"/>
                                                    <Setter Property="Foreground" Value="#999999"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 状态指示 -->
                    <StackPanel Grid.Column="4" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <TextBlock Text="状态:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"
                                   FontSize="14"/>

                        <!-- 状态指示灯 -->
                        <Ellipse Width="14" 
                                 Height="14" 
                                 Fill="{Binding ConnectionIndicatorColor}"
                                 Stroke="#555555"
                                 StrokeThickness="1"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{Binding ConnectionIndicatorColor, Converter={StaticResource BoolToColorConverter}}" 
                                                  BlurRadius="6" 
                                                  ShadowDepth="0" 
                                                  Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- 状态文本 -->
                        <TextBlock Text="{Binding ConfiguredCameraStatusText}" 
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Medium"/>
                    </StackPanel>

                    <!-- 占位空间 -->
                    <Border Grid.Column="5"/>

                    <!-- 说明文本 -->
                    <TextBlock Grid.Column="6" 
                               Text="💡 配置连接支持断线自动重连" 
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#666666"
                               FontStyle="Italic"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ========== 原有内容区域（保持不变） ========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧控制面板 -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 相机列表 -->
                        <GroupBox Header="相机列表（枚举连接）" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Content="刷新列表" Command="{Binding RefreshCameraListCommand}" 
                                        Margin="0,5" Height="30"/>
                                <ComboBox ItemsSource="{Binding CameraList}" 
                                          SelectedIndex="{Binding SelectedCameraIndex}"
                                          Height="30" Margin="0,5"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                                    <Button Content="连接" Command="{Binding ConnectCameraCommand}" 
                                            Width="70" Margin="0,0,5,0" Height="30"/>
                                    <Button Content="断开" Command="{Binding DisconnectCameraCommand}" 
                                            Width="70" Height="30"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 采集控制 -->
                        <GroupBox Header="采集控制" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Content="开始采集" Command="{Binding StartCaptureCommand}" 
                                        Margin="0,5" Height="30"/>
                                <Button Content="停止采集" Command="{Binding StopCaptureCommand}" 
                                        Margin="0,5" Height="30"/>
                                <Button Content="单次采集" Command="{Binding CaptureOnceCommand}" 
                                        Margin="0,5" Height="30"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 相机参数 -->
                        <GroupBox Header="相机参数" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="曝光时间(μs):" Width="90" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding ExposureTime}" Width="150"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="增益:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Gain}" Width="150"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="帧率:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding FrameRate}" Width="150"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="像素格式:" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding PixelFormats}" 
                                              SelectedItem="{Binding SelectedPixelFormat}"
                                              Width="150"/>
                                </StackPanel>
                                <Button Content="应用设置" Command="{Binding ApplySettingsCommand}" 
                                        Margin="0,10,0,0" Height="30"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 图像保存 -->
                        <GroupBox Header="图像保存" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding SavePath}" 
                                           TextWrapping="Wrap" 
                                           Margin="0,0,0,5"
                                           Foreground="Gray"/>
                                <Button Content="选择保存路径" Command="{Binding SelectSavePathCommand}" 
                                        Margin="0,0,0,5" Height="30"/>
                                <Button Content="保存当前图像" Command="{Binding SaveImageCommand}" 
                                        Height="30"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 状态信息 -->
                        <GroupBox Header="状态信息">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="连接状态:" Width="80"/>
                                    <TextBlock Text="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}" 
                                               Foreground="Green"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="采集状态:" Width="80"/>
                                    <TextBlock Text="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityConverter}}" 
                                               Foreground="Green"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="帧数:" Width="80"/>
                                    <TextBlock Text="{Binding FrameCount}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="分辨率:" Width="80"/>
                                    <TextBlock Text="{Binding CurrentResolution}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="实时帧率:" Width="80"/>
                                    <TextBlock Text="{Binding CurrentFps, StringFormat={}{0:F2} fps}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧图像显示 -->
            <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 图像显示区域 -->
                    <Border Grid.Row="0" Background="Black">
                        <Viewbox Stretch="Uniform">
                            <Image Source="{Binding CurrentImage}" 
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Viewbox>
                    </Border>

                    <!-- 状态栏 -->
                    <Border Grid.Row="1" 
                            Background="{Binding IsStatusError, Converter={StaticResource BoolToColorConverter}}" 
                            Padding="10,5" 
                            Margin="0,10,0,0"
                            CornerRadius="3">
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="White" 
                                   FontWeight="Medium"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
