<UserControl x:Class="SeedCut.Views.Recipe.RecipeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#FF2D2D30">

    <UserControl.Resources>
        <!-- 颜色定义 -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF3E3E42"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF555555"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF007ACC"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFFFCC00"/>
        <SolidColorBrush x:Key="AutoCreatedBrush" Color="#FFFFF3CD"/>

        <!-- 布尔到可见性转换器 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- 按钮样式 -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF007ACC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表项样式 -->
        <Style x:Key="GroupListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#FF555555">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF505050"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文本框样式 -->
        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 下拉框样式 -->
        <Style x:Key="EditorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                  Grid.Column="2"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#FF1E1E1E" BorderBrush="#FF555555" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="#FF3E3E42">
                                                    <Path x:Name="Arrow" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      Margin="6,4,23,4"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                <Border x:Name="DropDown"
                                Background="#FF2D2D30"
                                BorderBrush="#FF555555"
                                BorderThickness="1"
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="#FF2D2D30" Padding="6,4">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF3E3E42"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF007ACC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 配方选择 -->
                <TextBlock Grid.Column="0" Text="当前配方:" Foreground="White" 
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding AvailableRecipes}"
                          SelectedItem="{Binding SelectedRecipeName, Mode=TwoWay}"
                          Style="{StaticResource EditorComboBoxStyle}"/>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="💾 保存" 
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="↩ 放弃" 
                            Command="{Binding DiscardCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="🔄 刷新" 
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"/>

                    <Separator Margin="8,4" Background="#FF555555"/>

                    <!-- 新建配方 -->
                    <TextBox x:Name="NewRecipeNameBox" 
                             Width="120" 
                             Text="{Binding NewRecipeName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EditorTextBoxStyle}"
                             ToolTip="输入新配方名称"/>
                    <Button Content="➕ 新建" 
                            Command="{Binding CreateRecipeCommand}"
                            CommandParameter="{Binding Text, ElementName=NewRecipeNameBox}"
                            Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：分组列表 -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="参数分组" Foreground="White" 
                               FontWeight="Bold" Padding="12,8"
                               Background="#FF252526"/>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Groups}"
                             SelectedItem="{Binding SelectedGroup}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource GroupListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayText}" FontSize="13"/>
                                    <TextBlock Text="{Binding GroupId}" FontSize="10" 
                                               Foreground="#FF888888" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" Width="4" 
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#FF555555"/>

            <!-- 右侧：参数编辑区 -->
            <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 分组信息编辑 -->
                    <Border Grid.Row="0" Background="#FF252526" Padding="12,8"
                            Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="分组名称:" Foreground="White" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding SelectedGroup.GroupName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource EditorTextBoxStyle}"/>

                            <TextBlock Grid.Column="2" Text="排序:" Foreground="White" 
                                       VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <TextBox Grid.Column="3" 
                                     Text="{Binding SelectedGroup.SortOrder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource EditorTextBoxStyle}"/>

                            <TextBlock Grid.Column="4" Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Center" Margin="16,0,0,0"
                                       Visibility="{Binding SelectedGroup.IsAutoCreated, Converter={StaticResource BoolToVisConverter}}"
                                       Text="⚠ 此分组由代码自动创建，请补充显示名称"/>
                        </Grid>
                    </Border>

                    <!-- 参数列表 -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding SelectedGroup.Parameters}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              Background="Transparent"
                              Foreground="White"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#FF555555"
                              RowBackground="#FF2D2D30"
                              AlternatingRowBackground="#FF333337"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF252526"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="#FF555555"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoCreated}" Value="True">
                                        <Setter Property="Background" Value="#33FFCC00"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- 参数Key -->
                            <DataGridTextColumn Header="参数Key" 
                                                Binding="{Binding Key}" 
                                                Width="120"
                                                IsReadOnly="True"/>

                            <!-- 显示名称 -->
                            <DataGridTextColumn Header="显示名称" 
                                                Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#FF1E1E1E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="4"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 值类型 -->
                            <DataGridTextColumn Header="类型" 
                                                Binding="{Binding ValueTypeDisplay}" 
                                                Width="80"
                                                IsReadOnly="True"/>

                            <!-- 值 -->
                            <DataGridTextColumn Header="值" 
                                                Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                Width="150">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#FF1E1E1E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="4"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 单位 -->
                            <DataGridTextColumn Header="单位" 
                                                Binding="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                Width="80">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#FF1E1E1E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="4"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 描述 -->
                            <DataGridTextColumn Header="描述" 
                                                Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                Width="*">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#FF1E1E1E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="4"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 空状态提示 -->
                    <TextBlock Grid.Row="1" 
                               Text="请选择左侧分组查看参数"
                               Foreground="#FF888888"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           Foreground="#FFAAAAAA"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FF4CAF50"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                        <Setter Property="Fill" Value="#FFFFCC00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="已保存"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                        <Setter Property="Text" Value="有未保存的修改"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
