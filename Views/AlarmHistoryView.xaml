<UserControl
    x:Class="SeedCut.Views.AlarmHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SeedCut.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="900"
    Background="#F5F5F5"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <!--  ✅ 修复：添加支持反转的转换器  -->
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter" />
        <local:BoolToStatusBgConverter x:Key="BoolToStatusBgConverter" />
        <local:StringToColorConverter x:Key="StringToColorConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="16,12"
            Background="White"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Text="🔔" />
                    <StackPanel>
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#333"
                            Text="报警管理" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#666"
                            Text="{Binding AlarmSummary}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Background="#E3F2FD"
                        BorderThickness="0"
                        Command="{Binding TriggerTestAlarmCommand}"
                        Content="🧪 测试报警"
                        Cursor="Hand"
                        Foreground="#1976D2" />
                    <Button
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Background="#4CAF50"
                        BorderThickness="0"
                        Command="{Binding AcknowledgeAllCommand}"
                        Content="✓ 全部确认"
                        Cursor="Hand"
                        Foreground="White" />
                    <Button
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Background="#FF9800"
                        BorderThickness="0"
                        Command="{Binding ClearRecoveredCommand}"
                        Content="清除已恢复"
                        Cursor="Hand"
                        Foreground="White" />
                    <Button
                        Padding="12,6"
                        Background="#F44336"
                        BorderThickness="0"
                        Command="{Binding ClearAllCommand}"
                        Content="全部清除"
                        Cursor="Hand"
                        Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  活动报警列表  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Background="White"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="16,10"
                    Background="#FAFAFA"
                    CornerRadius="8,8,0,0">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="活动报警" />
                </Border>

                <!--  ✅ 修复：使用专用的反转转换器  -->
                <!--  无报警提示（当HasActiveAlarms为False时显示）  -->
                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="#4CAF50"
                    Text="✓ 当前无活动报警"
                    Visibility="{Binding HasActiveAlarms, Converter={StaticResource InverseBoolToVisConverter}}" />

                <!--  报警列表（当HasActiveAlarms为True时显示）  -->
                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding HasActiveAlarms, Converter={StaticResource BoolToVisConverter}}">
                    <ItemsControl Padding="8" ItemsSource="{Binding ActiveAlarms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--  ✅ 修复：使用StringToColorConverter将颜色字符串转换为Brush  -->
                                <Border
                                    Margin="4"
                                    Padding="12"
                                    Background="{Binding LevelBackgroundColor, Converter={StaticResource StringToColorConverter}}"
                                    CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  图标  -->
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Text="{Binding LevelIcon}" />

                                        <!--  信息  -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,0,8,0"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding LevelColor, Converter={StaticResource StringToColorConverter}}"
                                                    Text="{Binding AlarmCode}" />
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="#333"
                                                    Text="{Binding Name}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,0,16,0"
                                                    FontSize="12"
                                                    Foreground="#666"
                                                    Text="{Binding SourceModule}" />
                                                <TextBlock
                                                    Margin="0,0,16,0"
                                                    FontSize="12"
                                                    Foreground="#666"
                                                    Text="{Binding TriggerTime, StringFormat='{}{0:HH:mm:ss}'}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#999"
                                                    Text="{Binding DurationText}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  状态和操作  -->
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Border
                                                Margin="0,0,8,0"
                                                Padding="8,4"
                                                Background="{Binding IsAcknowledged, Converter={StaticResource BoolToStatusBgConverter}}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="White"
                                                    Text="{Binding StatusText}" />
                                            </Border>
                                            <!--  ✅ 修复：确认按钮在未确认时显示  -->
                                            <Button
                                                Padding="12,6"
                                                Background="#4CAF50"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding AlarmId}"
                                                Content="确认"
                                                Cursor="Hand"
                                                Foreground="White"
                                                Visibility="{Binding IsAcknowledged, Converter={StaticResource InverseBoolToVisConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--  分隔标题  -->
        <Border
            Grid.Row="2"
            Padding="16,10"
            Background="White"
            CornerRadius="8,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    FontWeight="Bold"
                    Foreground="#333"
                    Text="历史记录" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Padding="8,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding RefreshHistoryCommand}"
                        Content="刷新"
                        Cursor="Hand"
                        Foreground="#1976D2" />
                    <Button
                        Padding="8,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ClearHistoryCommand}"
                        Content="清除历史"
                        Cursor="Hand"
                        Foreground="#F44336" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  历史记录列表  -->
        <Border
            Grid.Row="3"
            Background="White"
            CornerRadius="0,0,8,8">
            <ListView
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding AlarmHistory}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn
                            Width="140"
                            DisplayMemberBinding="{Binding TriggerTime, StringFormat='{}{0:MM-dd HH:mm:ss}'}"
                            Header="时间" />
                        <GridViewColumn Width="60" Header="级别">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LevelIcon}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn
                            Width="80"
                            DisplayMemberBinding="{Binding AlarmCode}"
                            Header="代码" />
                        <GridViewColumn
                            Width="200"
                            DisplayMemberBinding="{Binding Name}"
                            Header="名称" />
                        <GridViewColumn
                            Width="100"
                            DisplayMemberBinding="{Binding SourceModule}"
                            Header="模块" />
                        <GridViewColumn
                            Width="100"
                            DisplayMemberBinding="{Binding DurationText}"
                            Header="持续时间" />
                        <GridViewColumn
                            Width="80"
                            DisplayMemberBinding="{Binding StatusText}"
                            Header="状态" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
