<Window
    x:Class="SeedCut.Views.LoadingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SeedCut.Views.Converters"
    xmlns:models="clr-namespace:SeedCut.Models"
    xmlns:views="clr-namespace:SeedCut.Views"
    Title="系统初始化"
    Width="800"
    Height="700"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <!--  本地进度条宽度转换器（简化版，直接使用百分比）  -->

        <!--  旋转动画  -->
        <Storyboard x:Key="RotationAnimation" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                From="0"
                To="360"
                Duration="0:0:1" />
        </Storyboard>
    </Window.Resources>

    <Border Background="#E3F2FD" CornerRadius="10">
        <Grid Margin="80">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Logo  -->
            <Ellipse
                Grid.Row="0"
                Width="100"
                Height="100"
                Margin="0,0,0,30"
                HorizontalAlignment="Center"
                Fill="#4CAF50" />
            <TextBlock
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="40"
                Foreground="White"
                Text="农" />

            <!--  标题  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                FontSize="28"
                FontWeight="Bold"
                Text="农高智造" />

            <!--  设备ID  -->
            <TextBlock
                Grid.Row="2"
                Margin="0,0,0,30"
                HorizontalAlignment="Center"
                FontSize="18"
                Text="设备AD438446590-347" />

            <!--  进度条 - 使用标准ProgressBar实现  -->
            <Border
                x:Name="ProgressBorder"
                Grid.Row="3"
                Height="10"
                Margin="0,0,0,20"
                Background="#E0E0E0"
                CornerRadius="5">
                <ProgressBar
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#2196F3"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Progress, Mode=OneWay}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <Border
                                    x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5" />
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </Border>

            <!--  状态文字  -->
            <TextBlock
                Grid.Row="4"
                Margin="0,0,0,30"
                HorizontalAlignment="Center"
                FontSize="16"
                Foreground="#666666"
                Text="{Binding StatusText}" />

            <!--  模块检查列表  -->
            <ItemsControl
                Grid.Row="5"
                MaxHeight="300"
                ItemsSource="{Binding Modules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="40" Margin="20,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  状态图标  -->
                            <Border
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Background="{Binding StatusColor}"
                                CornerRadius="12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="checking">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource RotationAnimation}" />
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.RenderTransform>
                                    <RotateTransform CenterX="12" CenterY="12" />
                                </Border.RenderTransform>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding StatusIcon}" />
                            </Border>

                            <!--  模块名称  -->
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{Binding ModuleName}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#757575" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="#212121" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!--  状态信息  -->
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{Binding MessageColor}"
                                Text="{Binding Message}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  失败提示区域  -->
            <Border
                Grid.Row="6"
                Margin="0,20,0,0"
                Padding="20"
                Background="#FFEBEE"
                BorderBrush="#F44336"
                BorderThickness="2"
                CornerRadius="5"
                Visibility="{Binding ErrorAreaVisibility}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#D32F2F"
                        Text="⚠ 系统检查失败" />

                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="14"
                        Foreground="#D32F2F"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap" />

                    <Button
                        Width="120"
                        Height="35"
                        HorizontalAlignment="Center"
                        Background="#F44336"
                        BorderThickness="0"
                        Click="ExitButton_Click"
                        Content="退出程序"
                        FontSize="14"
                        Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
